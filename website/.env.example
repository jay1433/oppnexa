# Copy to .env.local for local testing, and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Your Resend API key — https://resend.com/api-keys  (keep secret)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are emailed to
CONTACT_EMAIL=you@oppnexa.com

# Verified Resend sender. Until oppnexa.com is verified in Resend,
# use onboarding@resend.dev (test mode only sends to your account email).
FROM_EMAIL=OppNexa <onboarding@resend.dev>
